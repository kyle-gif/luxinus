{
  "name": "luxinus",
  "version": "0.1.0",
  "description": "Luxinus — a local photo editor with optional ChatGPT Codex image chat and editing tools.",
  "author": "Luxinus",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "test": "node scripts/test.cjs",
    "test:onnx": "node scripts/smoke-onnx.cjs",
    "test:electron": "electron scripts/electron-smoke.cjs",
    "test:electron:restoration": "electron scripts/electron-restoration-smoke.cjs",
    "test:electron:agent": "electron scripts/electron-agent-smoke.cjs",
    "test:electron:codex": "electron scripts/electron-codex-smoke.cjs",
    "test:electron:chat": "electron scripts/electron-chat-smoke.cjs",
    "test:electron:viewport": "electron scripts/electron-viewport-smoke.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "exiftool-vendored": "^30.5.0",
    "fast-xml-parser": "^4.5.7",
    "libraw-wasm": "^1.6.0",
    "onnxruntime-node": "^1.27.0",
    "sharp": "^0.35.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
